---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tabs from '../components/Tabs.astro';
import Header from '../components/Header.astro';
import HeaderBanner from '../components/HeaderBanner.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Shouko">
  <Header />
  <HeaderBanner />

  <main class="max-w-[1500px] mx-auto px-8 py-12 grid grid-cols-1 lg:grid-cols-12 gap-12">
    <aside class="lg:col-span-4 xl:col-span-3 relative">
      <Sidebar />
    </aside>

    <section class="lg:col-span-8 xl:col-span-9">
      <Tabs />
    </section>
  </main>
  <Footer />
</BaseLayout>

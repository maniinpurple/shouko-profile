---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tabs from '../components/Tabs.astro';
import Header from '../components/Header.astro';
import HeaderBanner from '../components/HeaderBanner.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Shouko">
  <Header />
  <HeaderBanner />

  <main class="max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-4 lg:gap-6">
    <aside class="md:col-span-2 lg:col-span-3 xl:col-span-4 relative">
      <Sidebar />
    </aside>
    
    <section class="md:col-span-10 lg:col-span-9 xl:col-span-8">
      <Tabs />
    </section>
  </main>
  <Footer />
</BaseLayout>

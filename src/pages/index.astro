---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Shouko">
  <!-- HEADER -->
  <header class="w-full bg-white/90 border-b border-gray-200 backdrop-blur-sm sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <nav class="flex items-center gap-6 text-sm font-semibold">
        <a class="nav-link hover:text-shoukoPurpleDark transition" href="/">HOME</a>
        <a class="nav-link hover:text-shoukoPurpleDark transition" href="https://github.com/vedokoush" target="_blank">GITHUB</a>
        <a class="nav-link hover:text-shoukoPurpleDark transition" href="https://open.spotify.com/playlist/3JP1MKsCrTERak9FnQVYg8" target="_blank">SPOTIFY</a>
        <a class="nav-link hover:text-shoukoPurpleDark transition" href="https://discord.com/users/556789221810241537" target="_blank">DISCORD</a>
      </nav>

      <div class="text-sm text-gray-500"><strong>🌸 こんにちは、私は Shoukoです 🌸</strong></div>
  </header>

  <!-- HEADER BANNER -->
  <div class="w-full bg-[url('/header.jpg')] bg-cover bg-center h-44 md:h-56 border-b border-gray-200"></div>

  <!-- MAIN -->
  <main class="max-w-6xl mx-auto px-6 py-10 grid grid-cols-1 md:grid-cols-12 gap-10">
    <!-- LEFT SIDEBAR -->
    <aside class="md:col-span-4 relative">
      <!-- Avatar -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 md:left-6 md:translate-x-0">
        <div class="w-140 h-140 rounded-full overflow-hidden border-[8px] border-white shadow-lg">
          <img src="/avatar.jpg" alt="avatar" class="w-full h-full object-cover" />
        </div>
      </div>

      <!-- Spacer to push profile card down -->
      <div class="h-44"></div>

      <!-- Profile Card -->
      <div class="profile-card mt-10">
        <h2 class="text-2xl text-shoukoPurpleDark font-bold"><strong>Shouko</strong></h2>
        <p class="text-sm text-gray-500">@vedokoush</p>

        <p class="mt-4 text-sm text-gray-700 leading-relaxed">
          Reina | Female | Gemini | INFP | Ravenclaw<br />
          Obsessed with Granblue Fantasy, IDOLiSH7, and Love Live! Hungry 24/7.
        </p>

        <div class="mt-6 border-t pt-4">
          <p class="text-sm font-semibold text-shoukoPurpleDark mb-1">Layout</p>
          <p class="text-sm text-gray-600">
            This layout features Narmaya from Granblue Fantasy — a cozy Tumblr/Twitter-style blend.
          </p>
        </div>
      </div>

      <!-- Friends -->
      <div class="profile-card mt-6">
        <h3 class="font-semibold text-shoukoPurpleDark">Best Friends</h3>
        <ul class="mt-3 text-sm text-gray-700 space-y-1">
          <li>Yuyu @Omikami</li>
          <li>Boonen @Bunnyama</li>
          <li>Nanago @_Nagisa</li>
          <li>Merlo @Dechromario</li>
        </ul>
      </div>

      <!-- Tags -->
      <div class="profile-card mt-6">
        <h3 class="font-semibold text-shoukoPurpleDark">Current Obsessions</h3>
        <ul class="mt-3 text-sm text-gray-700 space-y-1">
          <li>#GranblueFantasy</li>
          <li>#IDOLiSH7</li>
          <li>#LoveLive</li>
        </ul>
      </div>
    </aside>

    <!-- RIGHT CONTENT -->
    <section class="md:col-span-8">
      <!-- Tabs -->
      <div class="flex items-center gap-6 mb-6 border-b border-gray-200 pb-3 text-sm font-semibold">
        <button class="tab-active">ABOUT</button>
        <button class="tab">POSTS & REPLIES</button>
        <button class="tab">DEVICES</button>
      </div>

    <!-- About Card (raw JSON) -->
    <div class="profile-card">
      <h3 class="text-lg font-bold text-shoukoPurpleDark">:: about me</h3>

      <pre class="mt-3 overflow-auto text-sm bg-gray-50 p-4 rounded-md border">
    {`const ME = {
      aliases: ["shouko", "ookami"],
      pronouns: ["he/him"],
      location: "Vietnam",
      OS: ["Arch Linux", "MacOS"],
      languages: [
        "python","cpp","javascript","csharp","golang","typescript","java"
      ],
      programming: {
        backend: ["go","flask","nodejs"],
        frontend: ["html","css","vue","tailwindcss"],
        databases: ["mysql"],
        technologies: ["docker","nginx"]
      },
      tricks: ["sqli","mitm","ddos"],
      editing_software: ["after effects","premiere pro","blender","borisfx","redgiant"],
    };`}
      </pre>
    </div>


      <!-- Post Cards -->
      <div class="mt-6 space-y-5">
        <article class="post-card hover:shadow-md transition">
          <div class="flex items-start gap-4">
            <img src="/card1.jpg" alt="" class="w-24 h-24 rounded-lg object-cover border" />
            <div class="flex-1">
              <h4 class="font-semibold text-shoukoPurpleDark text-base">JEANNE D'ARC</h4>
              <p class="text-sm text-gray-600 mt-1">Element: Dark | Race: Human | Style: Attack</p>
            </div>
            <div class="text-xs text-gray-400">1200</div>
          </div>
        </article>

        <article class="post-card hover:shadow-md transition">
          <div class="flex items-start gap-4">
            <img src="/card2.jpg" alt="" class="w-24 h-24 rounded-lg object-cover border" />
            <div class="flex-1">
              <h4 class="font-semibold text-shoukoPurpleDark text-base">ZOOEY</h4>
              <p class="text-sm text-gray-600 mt-1">Race: Primal | Specialty: Saber</p>
            </div>
            <div class="text-xs text-gray-400">1180</div>
          </div>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

---
const DISCORD_ID = '556789221810241537';
---

<div class="left-to-right profile-card" id="discord-status">
  <h3 class="text-sm font-bold text-shoukoPurpleDark mb-3 flex items-center gap-2">
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
      <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
    </svg>
    Discord Status
  </h3>

  <div class="animate-pulse">
    <div class="h-16 bg-gray-200 dark:bg-shoukoDarkBorder rounded"></div>
  </div>
</div>

<script define:vars={{ DISCORD_ID }}>
  const statusColors = {
    online: 'bg-green-500',
    idle: 'bg-yellow-500',
    dnd: 'bg-red-500',
    offline: 'bg-gray-400'
  };

  const statusText = {
    online: 'Online',
    idle: 'Idle',
    dnd: 'Do Not Disturb',
    offline: 'Offline'
  };

  function updateStatus(data) {
    const container = document.getElementById('discord-status');
    if (!container) return;

    const activity = data.activities.find(a => a.type !== 4);
    
    let html = `
      <h3 class="text-sm font-bold text-shoukoPurpleDark dark:text-shoukoDarkAccent mb-3 flex items-center gap-2">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        Discord Status
      </h3>

      <div class="flex items-center gap-3 mb-3">
        <div class="relative">
          <img 
            src="https://cdn.discordapp.com/avatars/${data.discord_user.id}/${data.discord_user.avatar}.png?size=64"
            alt="Discord Avatar"
            class="w-14 h-14 rounded-full border-2 border-gray-200 dark:border-shoukoDarkBorder"
          />
          <div class="absolute bottom-0 right-0 w-4 h-4 ${statusColors[data.discord_status]} rounded-full border-2 border-white shadow-sm"></div>
        </div>
        
        <div class="flex-1">
          <p class="font-semibold text-sm text-gray-800 dark:text-shoukoDarkText">
            ${data.discord_user.username}${data.discord_user.discriminator !== '0' ? `<span class="text-gray-400">#${data.discord_user.discriminator}</span>` : ''}
          </p>
          <p class="text-xs text-gray-600 dark:text-shoukoDarkTextSecondary">${statusText[data.discord_status]}</p>
        </div>
      </div>
    `;

    if (activity) {
      html += `
        <div class="bg-gray-50 dark:bg-shoukoDarkBorder rounded-lg p-3 mb-2">
          <p class="text-xs font-semibold text-gray-700 dark:text-shoukoDarkText mb-1">Currently Playing</p>
          <p class="text-sm font-medium text-shoukoPurpleDark dark:text-shoukoDarkAccent">${activity.name}</p>
          ${activity.details ? `<p class="text-xs text-gray-600 dark:text-shoukoDarkTextSecondary mt-1">${activity.details}</p>` : ''}
          ${activity.state ? `<p class="text-xs text-gray-500 dark:text-shoukoDarkTextMuted">${activity.state}</p>` : ''}
        </div>
      `;
    }

    if (data.listening_to_spotify && data.spotify) {
      html += `
        <div class="bg-gradient-to-r from-green-50 to-green-100 dark:from-shoukoDarkBorder dark:to-shoukoDarkCard rounded-lg p-3">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-4 h-4 text-green-600 dark:text-shoukoDarkGreen" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
            </svg>
            <p class="text-xs font-semibold text-green-700 dark:text-shoukoDarkGreen">Listening to Spotify</p>
          </div>
          <div class="flex items-center gap-3">
            <img 
              src="${data.spotify.album_art_url}" 
              alt="Album Art" 
              class="w-12 h-12 rounded shadow-sm"
            />
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-gray-800 dark:text-shoukoDarkText truncate">${data.spotify.song}</p>
              <p class="text-xs text-gray-600 dark:text-shoukoDarkTextSecondary truncate">${data.spotify.artist}</p>
            </div>
          </div>
        </div>
      `;
    }

    container.innerHTML = html;
  }

  // Fetch initial data
  fetch(`https://api.lanyard.rest/v1/users/${DISCORD_ID}`)
    .then(res => res.json())
    .then(res => updateStatus(res.data))
    .catch(err => console.error('Lanyard error:', err));

  // WebSocket for real-time updates
  const ws = new WebSocket('wss://api.lanyard.rest/socket');
  
  ws.onopen = () => {
    ws.send(JSON.stringify({
      op: 2,
      d: { subscribe_to_id: DISCORD_ID }
    }));
  };

  ws.onmessage = (event) => {
    const msg = JSON.parse(event.data);
    if (msg.t === 'INIT_STATE' || msg.t === 'PRESENCE_UPDATE') {
      updateStatus(msg.d);
    }
  };

  // Heartbeat
  setInterval(() => {
    if (ws.readyState === WebSocket.OPEN) {
      ws.send(JSON.stringify({ op: 3 }));
    }
  }, 30000);
</script>